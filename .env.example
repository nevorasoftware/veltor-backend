# =============================================================================
# VELTOR — Variables de Entorno del Backend
# Desarrollado por Nevora Software
# =============================================================================

# Identidad del Producto y Localización
PRODUCT_NAME=VELTOR
PRODUCT_COMPANY=Nevora Software
PRODUCT_TAGLINE="Financiamiento inteligente. Movilidad a tu alcance."
APP_LOCALE=es-SV
APP_CURRENCY=USD
APP_TIMEZONE=America/El_Salvador

# Servidor y Entorno
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veltor_db?schema=public"

# Seguridad y Autenticación (JWT_SECRET: mínimo 32 caracteres aleatorios, p. ej. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Throttler (Rate Limiting por IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# Almacenamiento de fotos y documentos: local (disco del servidor) o gdrive (Google Drive).
# Con gdrive se crea la carpeta VELTOR con Vehiculos/, Creditos/<número de crédito>/ y Clientes/.
# Usa las credenciales GMAIL_* (el refresh token debe incluir el permiso drive.file: vuelve a ejecutar
# scripts/gmail-auth.mjs) o, si prefieres otra cuenta, GOOGLE_DRIVE_CLIENT_ID/_CLIENT_SECRET/_REFRESH_TOKEN.
STORAGE_DRIVER=local
GOOGLE_DRIVE_ROOT_FOLDER=VELTOR
STORAGE_LOCAL_ROOT=./uploads/documents
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=veltor-documents-private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# Correo (Notificaciones) vía API de Gmail con OAuth2 — funciona por HTTPS, no requiere SMTP.
# 1. Google Cloud Console: habilitar "Gmail API" y crear un ID de cliente OAuth tipo "App de escritorio".
# 2. Ejecutar `node scripts/gmail-auth.mjs <CLIENT_ID> <CLIENT_SECRET>` para obtener el refresh token.
# Sin estas variables la API funciona normal, solo no envía correos.
MAIL_ENABLED=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Cuenta de Gmail que envía (la misma con la que se autorizó el refresh token)
GMAIL_SENDER=
MAIL_FROM_NAME="VELTOR Notificaciones"
MAIL_REPLY_TO=
# Correos del personal que reciben aviso de cada nuevo prospecto (separados por coma)
NOTIFY_STAFF_EMAILS=
# Días de anticipación del recordatorio de pago, solo si no se ha parametrizado en Parámetros y Tasas.
# El proceso de cobranza corre a diario a las 8:00 (recordatorios y avisos de cuota vencida con mora).
PAYMENT_REMINDER_DAYS=3
# URL pública del frontend, para los enlaces al portal en los correos
APP_PUBLIC_URL=

# Superadministrador inicial: se crea al arrancar solo si no existe ningún usuario de personal.
# Si BOOTSTRAP_ADMIN_PASSWORD está vacío se genera una contraseña temporal y se imprime en los logs.
# Al primer ingreso se exige cambiar la contraseña.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME="Administrador"

# Producto financiero por defecto (se crea al arrancar solo si no hay uno activo)
PRODUCT_FINANCING_NAME="Crédito Vehicular Estándar"
PRODUCT_DEFAULT_MONTHLY_RATE=0.015
PRODUCT_MIN_MONTHLY_RATE=0.012
PRODUCT_MAX_MONTHLY_RATE=0.022
PRODUCT_MIN_TERM_MONTHS=12
PRODUCT_MAX_TERM_MONTHS=72
PRODUCT_MIN_DOWN_PERCENT=15
PRODUCT_GRACE_DAYS=5
PRODUCT_LATE_MONTHLY_RATE=0.03
