# =============================================================================
# VELTOR — Variables de Entorno del Backend
# Desarrollado por Nevora Software
# =============================================================================

# Identidad del Producto y Localización
PRODUCT_NAME=VELTOR
PRODUCT_COMPANY=Nevora Software
PRODUCT_TAGLINE="Financiamiento inteligente. Movilidad a tu alcance."
APP_LOCALE=es-SV
APP_CURRENCY=USD
APP_TIMEZONE=America/El_Salvador

# Servidor y Entorno
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veltor_db?schema=public"

# Seguridad y Autenticación
JWT_SECRET=super-secure-veltor-jwt-secret-key-32-chars-min!
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super-secure-veltor-refresh-token-secret-key!
REFRESH_TOKEN_EXPIRES_IN=7d

# Throttler (Rate Limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Almacenamiento de Documentos (S3 Compatible o Local Privado)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads/documents
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=veltor-documents-private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# Servidor de Correo SMTP (Notificaciones)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VELTOR Notificaciones <notificaciones@veltor.app>"

# Bootstrap de Superadministrador Inicial
BOOTSTRAP_ADMIN_EMAIL=admin@veltor.app
BOOTSTRAP_ADMIN_PASSWORD=VeltorAdmin2026!
BOOTSTRAP_ADMIN_NAME="Super Administrador VELTOR"
